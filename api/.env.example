AMAL_ENV=development
AMAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AMAL_DATABASE_PATH=./data/amal.sqlite3
AMAL_MAX_TEXT_LENGTH=2500
AMAL_RATE_LIMIT=30/minute
AMAL_FRONTEND_URL=http://127.0.0.1:5173

# Create a Google OAuth Web application client in Google Cloud Console.
# Add this exact URI to its authorized redirect URIs, then fill in the secrets.
AMAL_GOOGLE_CLIENT_ID=
AMAL_GOOGLE_CLIENT_SECRET=
AMAL_GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/google/callback
